# Скопируй в .env и поправь под себя. .env не коммитить.

# Локальный Postgres в docker compose (учётные данные только для разработки)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Этапы 1-3
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# Этап 4: ключ можно получить на https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Этап 6
VECTOR_BACKEND=pgvector
QDRANT_URL=http://localhost:6333

# Этап 10: трейсы в Jaeger (docker compose --profile otel up -d); пусто — спаны никуда не уходят
OTEL_EXPORTER_OTLP_ENDPOINT=
