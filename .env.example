# Copy to .env and adjust. Never commit .env.

# Local Postgres in docker compose (dev-only credentials)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Stage 1-3
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Stage 4: get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Stage 6
VECTOR_BACKEND=pgvector
QDRANT_URL=http://localhost:6333
